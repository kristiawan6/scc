# Copy to api/.env and fill in. Bun loads api/.env automatically.

# ─── Application ────────────────────────────────────────────────
# development | production (production = Secure cookies)
NODE_ENV=development
PORT=3001
# Website origin(s) allowed to call the API with cookies, comma-separated.
# Must match where the website runs (bun dev = http://localhost:3000).
FRONTEND_URL=http://localhost:3000
# IPs of your reverse proxy (nginx, Caddy, load balancer), comma-separated, so the API
# reads the real client IP from X-Forwarded-For for rate limiting. Leave empty when
# the API is reached directly. Behind a proxy without this, all visitors share one limit.
TRUSTED_PROXIES=

# ─── Database ───────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=scc
DATABASE_USER=scc
DATABASE_PASSWORD=

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional, default 0. Pick a free index on a shared server.
REDIS_DB=0

# ─── JWT ────────────────────────────────────────────────────────
# Each secret: at least 32 random characters, different from each other.
# bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ─── File uploads ───────────────────────────────────────────────
# Used only when S3_ENDPOINT is empty: files are stored on disk and served at /uploads.
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ─── MinIO S3 ───────────────────────────────────────────────────
# Leave S3_ENDPOINT empty to store uploads on local disk instead.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=scc
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Public URL prefix for uploaded files (bucket included when path-style), e.g. https://cdn.gbiscc.org/scc
S3_PUBLIC_BASE=http://localhost:9000/scc
# true = upload with ACL public-read (needed when the bucket has no public-read policy)
S3_PUBLIC_READ=true
