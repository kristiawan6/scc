# HTTPS certificates are issued automatically once DNS points here.
{
	servers {
		# The site sits behind the Cloudflare proxy: trust its edge ranges
		# (https://www.cloudflare.com/ips, list as of Nov 2026; refresh if Cloudflare adds ranges)
		# and take the visitor IP from CF-Connecting-IP.
		# Requests that bypass Cloudflare keep their real socket IP.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3001 {
		# One hop: the visitor IP Caddy resolved above (used by the API's rate limiter).
		header_up X-Forwarded-For {client_ip}
	}
}
